# ==============================================================================
# Gamified Course Generator — Environment Configuration Template
#
# Instructions:
# 1. Copy this file to `backend/.env`:
#      cp backend/.env.example backend/.env
# 2. Add your provider API key(s) below.
# 3. Keep `backend/.env` secret and never commit it to source control.
# ==============================================================================

# LLM Provider Failover Order (comma-separated priority list)
# Options: gemini,cerebras,groq,mistral,github_models,openrouter
LLM_PROVIDER_ORDER=gemini,cerebras,groq,mistral,github_models,openrouter

# --- 1. Google Gemini (https://aistudio.google.com/) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- 2. Cerebras (https://cerebras.ai/) ---
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama-3.3-70b
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# --- 3. Groq (https://console.groq.com/) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- 4. Mistral AI (https://console.mistral.ai/) ---
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# --- 5. GitHub Models (Personal Access Token with models permission) ---
GITHUB_MODELS_TOKEN=your_github_token_here
GITHUB_MODELS_MODEL=openai/gpt-4.1
# GITHUB_MODELS_BASE_URL=https://models.github.ai/inference

# --- 6. OpenRouter (https://openrouter.ai/) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Gamified Course Prototype

# --- Runtime & Tuning Parameters ---
LLM_TIMEOUT_SECONDS=150.0
LLM_MAX_RETRIES_PER_PROVIDER=1
LLM_MAX_OUTPUT_TOKENS=16000
LLM_TEMPERATURE=0.15
LLM_RETRY_BASE_SECONDS=1.25
LLM_MAX_LECTURE_CHARS_PER_MODULE=24000

